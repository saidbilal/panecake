{
  "name": "panecake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A desktop-style sidebar around the real Claude Code CLI",
  "license": "MIT",
  "scripts": {
    "start": "node server.mjs --print-url",
    "setup": "npm install --ignore-scripts && node scripts/vendor.mjs",
    "build": "npm run setup && bash mac/build.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "node-pty": "1.1.0",
    "ws": "8.22.1"
  }
}
